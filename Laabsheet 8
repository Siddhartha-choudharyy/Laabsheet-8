
1. Prime Number Check

Checks if a given number is prime by testing factors up to its square root.
cpp
#include <iostream>
#include <cmath>

bool isPrime(int n) {
    if (n <= 1) return false;
    if (n == 2) return true;
    if (n % 2 == 0) return false;
    
    for (int i = 3; i <= std::sqrt(n); i += 2) {
        if (n % i == 0) return false;
    }
    return true;
}


2. Fibonacci Series

Prints the Fibonacci sequence up to \(N\) terms.
cpp
#include <iostream>

void printFibonacci(int n) {
    if (n <= 0) return;
    
    long long t1 = 0, t2 = 1;
    for (int i = 1; i <= n; ++i) {
        std::cout << t1 << " ";
        long long nextTerm = t1 + t2;
        t1 = t2;
        t2 = nextTerm;
    }
    std::cout << std::endl;
}


3. Bubble Sort Technique

Sorts an array of a given size in ascending order.
cpp
#include <iostream>

void bubbleSort(int arr[], int size) {
    for (int i = 0; i < size - 1; ++i) {
        bool swapped = false;
        for (int j = 0; j < size - i - 1; ++j) {
            if (arr[j] > arr[j + 1]) {
                std::swap(arr[j], arr[j + 1]);
                swapped = true;
            }
        }
        if (!swapped) break; // Optimization if already sorted
    }
}


4. String Copy

Copies characters from the source string into the destination buffer (equivalent to standard strcpy).
cpp
void copyString(char dest[], const char src[]) {
    int i = 0;
    while (src[i] != '\0') {
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0'; // Null-terminate destination string
}


5. Count Words in a String

Counts words by tracking state transitions between whitespace and characters.
cpp
#include <string>
#include <cctype>

int countWords(const std::string& str) {
    int count = 0;
    bool inWord = false;
    
    for (char ch : str) {
        if (std::isspace(ch)) {
            inWord = false;
        } else if (!inWord) {
            inWord = true;
            count++;
        }
    }
    return count;
}


6. Binary Search

Searches a sorted array. Returns the element's index if found; otherwise, returns -1.
cpp
int binarySearch(const int arr[], int size, int target) {
    int left = 0;
    int right = size - 1;
    
    while (left <= right) {
        int mid = left + (right - left) / 2;
        
        if (arr[mid] == target) return mid;
        if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return -1;
}


7. Matrix Addition

Adds two matrices of size \(R \times C\) and stores the outcome in a third result matrix.
cpp
#include <iostream>

const int MAX_R = 10;
const int MAX_C = 10;

void addMatrices(int A[MAX_R][MAX_C], int B[MAX_R][MAX_C], int C[MAX_R][MAX_C], int rows, int cols) {
    for (int i = 0; i < rows; ++i) {
        for (int j = 0; j < cols; ++j) {
            C[i][j] = A[i][j] + B[i][j];
        }
    }
}


8. Sum of Diagonal Elements

Finds the sum of the primary (main) diagonal numbers in a square matrix.
cpp
#include <iostream>

const int MAX_SIZE = 10;

int sumPrincipalDiagonal(int matrix[MAX_SIZE][MAX_SIZE], int size) {
    int sum = 0;
    for (int i = 0; i < size; ++i) {
        sum += matrix[i][i];
    }
    return sum;
}
Use code with caution.

